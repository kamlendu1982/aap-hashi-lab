# Generated by Terraform templatefile() for ansible_playbook execution
[all]
%{ for idx, ip in instance_ips ~}
${name_tag}-${idx + 1} ansible_host=${ip} ansible_user=${ansible_user} ansible_ssh_private_key_file=${private_key_file} ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
%{ endfor ~}

[all:vars]
ansible_python_interpreter=/usr/bin/python3
