# Dynamic inventory generated after Terraform apply
[all]
{% for ip in instance_ips %}
{{ aws_name_tag | default('ec2') }}-{{ loop.index }} ansible_host={{ ip }} ansible_user={{ ec2_ssh_user }} ansible_ssh_private_key_file={{ ec2_ssh_private_key_file }} ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
{% endfor %}

[all:vars]
ansible_python_interpreter=/usr/bin/python3
